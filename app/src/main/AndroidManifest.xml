<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 文件访问权限（用于上传图片） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 震动权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolForum"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 登录Activity -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SchoolForum" />
            
        <!-- 帖子详情Activity -->
        <activity
            android:name=".ui.post.PostDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 栏目帖子浏览Activity -->
        <activity
            android:name=".ui.post.CategoryPostsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 聊天Activity -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 会话列表Activity -->
        <activity
            android:name=".ui.chat.ConversationsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 通知Activity -->
        <activity
            android:name=".ui.notification.NotificationsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 个人主页Activity -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 设置Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 发帖/编辑帖子Activity -->
        <activity
            android:name=".ui.post.EditPostActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 图片预览Activity -->
        <activity
            android:name=".ui.preview.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.SchoolForum.ImagePreview" />
            
        <!-- 收藏列表Activity -->
        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 关注/粉丝列表Activity -->
        <activity
            android:name=".ui.follow.FollowListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 黑名单Activity -->
        <activity
            android:name=".ui.blacklist.BlacklistActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 动态页面Activity -->
        <activity
            android:name=".ui.follow.FollowingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 举报页面Activity -->
        <activity
            android:name=".ui.report.ReportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 编辑资料Activity -->
        <activity
            android:name=".ui.settings.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 修改密码Activity -->
        <activity
            android:name=".ui.settings.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 忘记密码Activity -->
        <activity
            android:name=".ui.login.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 修改邮箱Activity -->
        <activity
            android:name=".ui.settings.ChangeEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 注销账号Activity -->
        <activity
            android:name=".ui.settings.DeleteAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 账户安全Activity -->
        <activity
            android:name=".ui.settings.AccountSecurityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- 修改QQ号Activity -->
        <activity
            android:name=".ui.settings.ChangeQQActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <!-- FileProvider for file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
    </application>

</manifest>
