<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================
         Material Design 3 主题配置
         ======================================== -->
    
    <!-- 主应用主题 - 浅色 -->
    <style name="Theme.SchoolForum" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/md3_primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/md3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md3_onPrimaryContainer</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/md3_secondary</item>
        <item name="colorOnSecondary">@color/md3_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md3_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md3_onSecondaryContainer</item>
        
        <!-- Tertiary colors -->
        <item name="colorTertiary">@color/md3_tertiary</item>
        <item name="colorOnTertiary">@color/md3_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md3_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md3_onTertiaryContainer</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/md3_error</item>
        <item name="colorOnError">@color/md3_onError</item>
        <item name="colorErrorContainer">@color/md3_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md3_onErrorContainer</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/md3_background</item>
        <item name="colorOnBackground">@color/md3_onBackground</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorOnSurface">@color/md3_onSurface</item>
        <item name="colorSurfaceVariant">@color/md3_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md3_onSurfaceVariant</item>
        
        <!-- Outline colors -->
        <item name="colorOutline">@color/md3_outline</item>
        <item name="colorOutlineVariant">@color/md3_outlineVariant</item>
        
        <!-- Inverse colors - 部分版本不支持，移除 -->
        <!-- <item name="colorInverseSurface">@color/md3_inverseSurface</item>
        <item name="colorInverseOnSurface">@color/md3_inverseOnSurface</item>
        <item name="colorInversePrimary">@color/md3_inversePrimary</item> -->
        
        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/md3_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Window -->
        <item name="android:windowBackground">@color/md3_background</item>
    </style>
    
    <!-- 启动页主题 -->
    <style name="Theme.SchoolForum.Splash" parent="Theme.SchoolForum">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    
    <!-- 图片预览主题 - 全屏深色 -->
    <style name="Theme.SchoolForum.ImagePreview" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    
    <!-- 半透明对话框主题 -->
    <style name="Theme.SchoolForum.Translucent" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/Animation.Dialog</item>
    </style>
    
    <!-- ========================================
         组件样式
         ======================================== -->
    
    <!-- 卡片样式 -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/md3_surface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>
    
    <style name="Widget.App.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md3_surfaceVariant</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
    </style>
    
    <style name="Widget.App.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/md3_surface</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="strokeColor">@color/md3_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <!-- 按钮样式 -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
    </style>
    
    <style name="Widget.App.Button.Primary" parent="Widget.App.Button">
        <item name="backgroundTint">@color/md3_primary</item>
        <item name="android:textColor">@color/md3_onPrimary</item>
    </style>
    
    <style name="Widget.App.Button.Secondary" parent="Widget.App.Button">
        <item name="backgroundTint">@color/md3_secondary</item>
        <item name="android:textColor">@color/md3_onSecondary</item>
    </style>
    
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/md3_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/md3_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/md3_primary</item>
    </style>
    
    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.Icon">
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">@color/md3_onPrimary</item>
    </style>
    
    <!-- 输入框样式 -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxBackgroundColor">@color/md3_surfaceVariant</item>
        <item name="hintTextColor">@color/md3_onSurfaceVariant</item>
    </style>
    
    <style name="Widget.App.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/md3_outline</item>
        <item name="hintTextColor">@color/md3_onSurfaceVariant</item>
    </style>
    
    <!-- 浮动按钮样式 -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="fabSize">normal</item>
        <item name="elevation">@dimen/fab_elevation</item>
        <item name="fabCustomSize">@dimen/fab_size</item>
        <item name="maxImageSize">@dimen/icon_md</item>
    </style>
    
    <style name="Widget.App.FloatingActionButton.Small" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="fabCustomSize">@dimen/fab_size_sm</item>
        <item name="maxImageSize">@dimen/icon_sm</item>
        <item name="fabSize">mini</item>
    </style>
    
    <!-- 底部导航样式 -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">@dimen/bottom_nav_icon_size</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.LabelMedium</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.ActiveIndicator</item>
    </style>
    
    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">@dimen/bottom_nav_indicator_width</item>
        <item name="android:height">@dimen/bottom_nav_indicator_height</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Corner.Full</item>
        <item name="backgroundColor">@color/bottom_nav_active</item>
    </style>
    
    <!-- 选项卡样式 -->
    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorHeight">@dimen/tab_indicator_height</item>
        <item name="tabIndicatorColor">@color/md3_primary</item>
        <item name="tabTextColor">@color/md3_onSurfaceVariant</item>
        <item name="tabSelectedTextColor">@color/md3_primary</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.LabelLarge</item>
    </style>
    
    <!-- 工具栏样式 -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/md3_onSurface</item>
        <item name="subtitleTextColor">@color/md3_onSurfaceVariant</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.TitleLarge</item>
    </style>
    
    <!-- 对话框样式 -->
    <style name="Widget.App.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
    </style>
    
    <!-- 底部抽屉样式 -->
    <style name="Widget.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>
    
    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Corner.Top</item>
    </style>
    
    <!-- ========================================
         文字外观
         ======================================== -->
    
    <style name="TextAppearance.App.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_5xl</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_4xl</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_3xl</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/md3_onBackground</item>
    </style>
    
    <style name="TextAppearance.App.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/md3_onSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.App.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/md3_onSurfaceVariant</item>
    </style>
    
    <!-- ========================================
         形状外观
         ======================================== -->
    
    <style name="ShapeAppearance.App.Corner.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_full</item>
    </style>
    
    <style name="ShapeAppearance.App.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>
    
    <style name="ShapeAppearance.App.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_md</item>
    </style>
    
    <style name="ShapeAppearance.App.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_lg</item>
    </style>
    
    <style name="ShapeAppearance.App.Corner.Top" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/bottom_sheet_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/bottom_sheet_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    
    <!-- ========================================
         动画
         ======================================== -->
    
    <style name="Animation.Dialog" parent="Animation.AppCompat.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    
    <style name="Animation.BottomSheet" parent="">
        <item name="android:windowEnterAnimation">@anim/bottom_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/bottom_sheet_exit</item>
    </style>
</resources>
